{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qonnect",
  "version": "0.1.0",
  "identifier": "com.qonnect.vpn",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Qonnect",
        "width": 900,
        "height": 620,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
